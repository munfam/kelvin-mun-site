---
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

interface Post {
  frontmatter: { title: string; description?: string; date: string };
}

const modules = import.meta.glob('/src/pages/notes/*.md', { eager: true }) as Record<
  string,
  Post
>;

const posts = Object.entries(modules)
  .map(([file, mod]) => {
    const slug = file.split('/').pop()!.replace('.md', '');
    return { slug, ...mod.frontmatter };
  })
  .sort((a, b) => (a.date < b.date ? 1 : -1));

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Base
  title="Notes — Kelvin Mun"
  description="Longer pieces on cloud infrastructure, free tiers and side projects."
>
  <main class="wrap">
    <section class="hero">
      <p class="eyebrow">Writing</p>
      <h1>Notes</h1>
      <p class="lede">
        Working notes, mostly about infrastructure that has to keep running after
        the novelty wears off.
      </p>
    </section>

    <hr />

    <ul class="note-list">
      {
        posts.map((post) => (
          <li>
            <time datetime={post.date}>{formatDate(post.date)}</time>
            <div>
              <a href={`${base}notes/${post.slug}/`}>{post.title}</a>
              {post.description && (
                <span class="note-desc">{post.description}</span>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
