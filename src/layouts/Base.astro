---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Notes on cloud infrastructure, cost control and the occasional side project.',
} = Astro.props;

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const favicon = `${base}favicon.svg`;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/notes', label: 'Notes' },
  { href: '/about', label: 'About' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site ?? Astro.url)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={base}>munfam</a>
        <nav class="site-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <span>© 2026 munfam</span>
        <span>Astro on Cloudflare Pages</span>
      </div>
    </footer>
  </body>
</html>
